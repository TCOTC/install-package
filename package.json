    "@typescript-eslint/parser": "8.58.0",
    "copy-webpack-plugin": "^11.0.0",
    "css-loader": "^6.7.1",
    "electron": "40.8.3",
    "esbuild-loader": "^3.0.1",
    "eslint": "^9.33.0",
    "fork-ts-checker-webpack-plugin": "^9.1.0",
    "globals": "^16.3.0",
    "mini-css-extract-plugin": "2.3.0",
    "sass": "^1.62.1",
    "sass-loader": "^12.6.0",
