{
  "name": "install-package",
  "version": "0.4.6",
  "description": "Install the specified GitHub repository marketplace package Release",
  "main": "index.js",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "lint": "eslint . --fix --cache",
    "lint:check": "eslint . --cache --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test \"tests/**/*.test.mjs\"",
    "dev": "webpack --mode development",
    "build": "webpack --mode production",
    "push": "git push origin HEAD --tags",
    "preview": "node tools/preview/run.mjs"
  },
  "keywords": [
    "开发者工具",
    "developer tool"
  ],
  "author": "Jeffrey Chen",
  "license": "MIT",
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^9.39.5",
    "@octokit/openapi-types": "^27.0.0",
    "@typescript-eslint/eslint-plugin": "8.58.0",
    "@typescript-eslint/parser": "8.58.0",
    "copy-webpack-plugin": "^11.0.0",
    "css-loader": "^6.7.1",
    "electron": "40.8.3",
    "esbuild-loader": "^3.0.1",
    "eslint": "^9.39.5",
    "fork-ts-checker-webpack-plugin": "^9.1.0",
    "globals": "^16.3.0",
    "mini-css-extract-plugin": "2.3.0",
    "sass": "^1.105.1",
    "sass-loader": "^12.6.0",
    "siyuan": "1.2.9",
    "tslib": "2.4.0",
    "typescript": "6.0.2",
    "webpack": "^5.111.1",
    "webpack-cli": "^5.0.2",
    "webpack-obfuscator": "^3.6.1",
    "zip-webpack-plugin": "^4.0.3"
  },
  "dependencies": {
    "siyuan-token-vault": "git+https://github.com/TCOTC/siyuan-token-vault.git#8b666168a554f3038b58f0aed9823dd74a5a185d"
  }
}
